BUSY_URL=http://10.0.4.20
# BUSY_API_TOKEN=12345678
TOGGL_API_TOKEN=your_toggl_api_token
TOGGL_WORKSPACE_ID=1234567
POLL_INTERVAL=1
TOGGL_SYNC_INTERVAL=30
TOGGL_HOURLY_LIMIT=500
REQUEST_TIMEOUT=10
# TOGGL_BILLABLE controls the billable status of new Toggl time entries.
# Accepted values (case-insensitive):
#   "Always billable"     - every new entry is marked billable
#   "Always not billable" - every new entry is marked not billable
#   "Copy last entry"     - copy the billable status from the most recent entry (default)
TOGGL_BILLABLE=Copy last entry
